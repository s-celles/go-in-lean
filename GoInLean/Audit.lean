import Lean
import GoInLean
/-!
# Soundness audit

`lake exe audit` loads the whole `GoInLean` library and, for every theorem
in the `Go` namespace, collects the axioms its proof depends on
(`Lean.collectAxioms`). It fails if any proof uses `sorryAx`, or any axiom
outside the allowed set. The allowed set has two tiers, reported per
theorem so that `targets/properties.yaml` can record the trust level:

* `kernel`   — only `propext`, `Classical.choice`, `Quot.sound` (standard
  Lean axioms); the proof is checked by the Lean kernel alone.
* `bv_decide` — additionally one per-theorem axiom named
  `<theorem>._native.bv_decide.ax_<n>_<m>` (Lean ≥ 4.35; earlier versions used
  `Lean.ofReduceBool`): the proof contains an LRAT certificate checked by a
  verified checker *compiled and run natively*, so the Lean compiler is in the
  trusted base for that theorem. `native_decide` would introduce an axiom of a
  different name and is therefore reported as FORBIDDEN here; it is also
  banned by the source scan in `scripts/check.sh`.

The output is JSON (`--json`) consumed by `scripts/validate_manifest.py`.
-/
open Lean

def stdAxioms : List Name := [``propext, ``Classical.choice, ``Quot.sound]
/-- Is `a` a native-evaluation axiom generated by `bv_decide` (for this theorem or for one it
depends on)? Such axioms are named `<theorem>._native.bv_decide.ax_<n>_<m>`. -/
def isBvDecideAxiom (a : Name) : Bool :=
  (a.toString.splitOn "._native.bv_decide.").length == 2

/-- Auto-generated auxiliary theorems (equation lemmas, `sizeOf_spec`, injectivity) are not
registered properties; they are skipped in the listing. -/
def isAutoGenerated (n : Name) : Bool :=
  let s := n.toString
  (s.splitOn ".eq_").length > 1 || s.endsWith "sizeOf_spec" || s.endsWith ".inj" || s.endsWith ".injEq"

structure Row where
  name : String
  tier : String
  axioms : List String

def main (args : List String) : IO UInt32 := do
  let json := args.contains "--json"
  initSearchPath (← findSysroot)
  let env ← importModules #[{ module := `GoInLean }] {} (loadExts := false)
  let mut rows0 : Array Row := #[]
  let mut bad : Array String := #[]
  let consts := env.constants.toList.filter fun (n, _) =>
    (`Go).isPrefixOf n && !n.isInternal
  for (n, ci) in consts do
    let isThm := match ci with | .thmInfo _ => true | _ => false
    unless isThm do continue
    if isAutoGenerated n then continue
    let (axsArr, _) ← Lean.Core.CoreM.toIO (Lean.collectAxioms n : Lean.CoreM (Array Name))
      { fileName := "<audit>", fileMap := default } { env }
    let axs : List Name := axsArr.toList
    let tier :=
      if axs.contains ``sorryAx then "SORRY"
      else if axs.all (fun a => stdAxioms.contains a) then "kernel"
      else if axs.all (fun a => stdAxioms.contains a || isBvDecideAxiom a) then "bv_decide"
      else "FORBIDDEN"
    if tier == "SORRY" || tier == "FORBIDDEN" then
      bad := bad.push s!"{n}: {axs}"
    rows0 := rows0.push { name := n.toString, tier, axioms := axs.map (·.toString) }
  let rows := rows0.qsort (·.name < ·.name)
  if json then
    let js := Json.arr (rows.map fun r => Json.mkObj [
      ("name", Json.str r.name), ("tier", Json.str r.tier),
      ("axioms", Json.arr (r.axioms.toArray.map Json.str))])
    IO.println js.compress
  else
    let nk := rows.filter (·.tier == "kernel") |>.size
    let nb := rows.filter (·.tier == "bv_decide") |>.size
    IO.println s!"audited {rows.size} theorems in namespace Go: {nk} kernel-only, {nb} via bv_decide (native LRAT check)"
    for r in rows do
      IO.println s!"  [{r.tier}] {r.name}"
  if !bad.isEmpty then
    IO.eprintln s!"AUDIT FAILED: {bad.size} theorem(s) use forbidden axioms:"
    for b in bad do IO.eprintln s!"  {b}"
    return 1
  return 0
