+// constFitsIn reports whether c, if it is an integer constant, is representable in a value of
+// the given size under domain d. A fact ext(x) op c is only carried over to x when it is: an
+// out-of-range constant makes the fact on x trivially true or false (already decided by the
+// limits of ext(x)), and later steps such as the x+delta reasoning compute with c at x's width,
+// which would truncate it.
+func constFitsIn(c *ssa.Value, size int64, d domain) bool {
+	if !c.IsGenericIntConst() || size >= 8 {
+		return true
+	}
+	bits := uint(size * 8)
+	if d == signed {
+		return c.AuxInt >= -(1<<(bits-1)) && c.AuxInt < 1<<(bits-1)
+	}
+	u := uint64(c.AuxInt)
+	if cs := c.Type.Size(); cs < 8 {
+		u &= 1<<(uint(cs)*8) - 1
+	}
+	return u < 1<<bits
+}
