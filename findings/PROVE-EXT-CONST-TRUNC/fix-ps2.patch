+// fitsSigned reports whether c is representable as a signed
+// integer of the given size in bytes.
+func fitsSigned(c int64, size int64) bool {
+	if size >= 8 {
+		return true
+	}
+	bits := uint(size * 8)
+	return c >= -(1<<(bits-1)) && c < 1<<(bits-1)
+}
